# ─────────────────────────────────────────────
# OpenNotebook — Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────

# ── Application ──────────────────────────────
APP_NAME=opennotebook
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-64-char-string
API_PORT=8000
FRONTEND_PORT=5173

# ── PostgreSQL ───────────────────────────────
POSTGRES_USER=opennotebook
POSTGRES_PASSWORD=change-me
POSTGRES_DB=opennotebook
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://opennotebook:change-me@postgres:5432/opennotebook

# ── Redis ────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Qdrant ───────────────────────────────────
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333

# ── MinIO (Object Storage) ───────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET_NAME=opennotebook-sources
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me

# ── Ollama (LLM Inference) ──────────────────
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3:8b-instruct

# ── AI / ML Models ──────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
RERANKER_MODEL=BAAI/bge-reranker-base
LLM_TEMPERATURE=0.1
LLM_CONTEXT_WINDOW=8192
MAX_RETRIEVED_CHUNKS=10

# ── Auth (JWT) ───────────────────────────────
JWT_SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── File Upload ──────────────────────────────
MAX_UPLOAD_SIZE_MB=50
MAX_FILES_PER_REQUEST=10

# ── Chunking ────────────────────────────────
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=100
CHUNK_MIN_SIZE_TOKENS=150
EMBEDDING_BATCH_SIZE=64

# ── Celery Worker ────────────────────────────
CELERY_WORKER_CONCURRENCY=2
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_RETRY_DELAY=30

# ── Observability ────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
LOKI_PORT=3100
FLOWER_PORT=5555

# ── CORS ─────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Logging ──────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Docker Registry (for make push/deploy) ──
REGISTRY=your-registry.example.com/opennotebook
TAG=latest
